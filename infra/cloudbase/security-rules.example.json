{
  "comment": "Traditional document-database client rules. Default deny. Real env id stays in local .env.",
  "database": {
    "admin_users": { "read": false, "write": false },
    "jobs": { "read": false, "write": false },
    "idempotency": { "read": false, "write": false },
    "audit_logs": { "read": false, "write": false },
    "app_config": { "read": false, "write": false }
  },
  "storage": {
    "acl": "ADMINONLY",
    "clientRead": false,
    "clientWrite": false
  },
  "functions": {
    "*": { "invoke": false },
    "cloudbase_auth": { "invoke": true },
    "mw-public": { "invoke": true },
    "mw-member": { "invoke": "auth != null" },
    "mw-admin": { "invoke": "auth.loginType != 'ANONYMOUS' && auth != null" },
    "mw-upload": { "invoke": false },
    "mw-pay-hook": { "invoke": false },
    "mw-jobs": { "invoke": false }
  }
}
