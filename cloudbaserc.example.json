      "timeout": 10,
      "runtime": "Nodejs20.19",
      "memorySize": 256,
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "mw-member",
      "timeout": 15,
      "runtime": "Nodejs20.19",
      "memorySize": 256,
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "mw-admin",
      "timeout": 15,
      "runtime": "Nodejs20.19",
      "memorySize": 256,
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "mw-upload",
      "timeout": 30,
      "runtime": "Nodejs20.19",
      "memorySize": 512,
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "mw-pay-hook",
      "timeout": 10,
      "runtime": "Nodejs20.19",
