    "mw10:resolve-known-ids": "node scripts/mw10-resolve-known-ids.mjs",
    "mw10:verify-leftovers": "node scripts/mw10-leftover-verify.mjs",
    "mw11:deploy": "node scripts/mw11-deploy.mjs",
    "mw11:verify": "node scripts/mw11-verify.mjs",
    "mw11:cleanup": "node scripts/mw11-cleanup.mjs",
    "mw11:import-known-ids": "node scripts/mw11-import-known-ids.mjs",
    "mw11:resolve-known-ids": "node scripts/mw11-resolve-known-ids.mjs",
    "mw11:verify-leftovers": "node scripts/mw11-leftover-verify.mjs",
    "mw12:deploy": "node scripts/mw12-deploy.mjs",
    "mw12:verify": "node scripts/mw12-verify.mjs",
    "mw12:cleanup": "node scripts/mw12-cleanup.mjs",
    "mw12:import-known-ids": "node scripts/mw12-import-known-ids.mjs",
    "mw12:resolve-known-ids": "node scripts/mw12-resolve-known-ids.mjs",
    "mw12:verify-leftovers": "node scripts/mw12-leftover-verify.mjs",
    "mw13:deploy": "node scripts/mw13-deploy.mjs",
    "mw13:import-known-ids": "node scripts/mw13-import-known-ids.mjs",
    "mw13:resolve-known-ids": "node scripts/mw13-resolve-known-ids.mjs",
    "mw13:cleanup": "node scripts/mw13-cleanup.mjs",
    "mw13:verify-leftovers": "node scripts/mw13-leftover-verify.mjs",
    "mw14:deploy": "node scripts/mw14-deploy.mjs",
    "mw14:verify": "node scripts/mw14-verify.mjs",
    "mw14:import-known-ids": "node scripts/mw14-import-known-ids.mjs",
    "mw14:resolve-known-ids": "node scripts/mw14-resolve-known-ids.mjs",
    "mw14:cleanup": "node scripts/mw14-cleanup.mjs",
    "mw14:verify-leftovers": "node scripts/mw14-leftover-verify.mjs",
