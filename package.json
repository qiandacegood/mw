{
  "name": "mw",
  "private": true,
  "version": "0.0.1",
  "description": "思维工坊工程。CloudBase SDK 与 CLI 使用锁定版本，不使用 latest。",
  "workspaces": [
    "apps/admin",
    "apps/miniprogram",
    "packages/shared",
    "services/api"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:prototypes": "node scripts/check-prototype-scripts.mjs",
    "test": "node scripts/check-prototype-scripts.mjs && node scripts/ensure-shared-js.mjs && node scripts/mw04-record.test.mjs && node scripts/mw04-assert.test.mjs && node scripts/mw05-secret-scan.test.mjs && node scripts/mw06-assert.test.mjs && node scripts/mw08-assert.test.mjs && node scripts/mw09-assert.test.mjs && node scripts/mw10-assert.test.mjs && node scripts/mw11-assert.test.mjs && node scripts/mw12-assert.test.mjs && node scripts/mw13-assert.test.mjs && node scripts/mw14-assert.test.mjs && node scripts/mw07b-assert.test.mjs && npm run test --workspaces --if-present",
    "build": "node scripts/ensure-shared-js.mjs && node scripts/mw05-emit-runtime.mjs && npm run build --workspaces --if-present",
    "mw05:write-local": "node scripts/mw05-write-local.mjs",
    "mw05:emit": "node scripts/mw05-emit-runtime.mjs",
    "mw05:deploy": "node scripts/mw05-deploy.mjs",
    "mw05:http-probe": "node scripts/mw05-http-probe.mjs",
    "mw04:validate": "node scripts/mw04-validate.mjs",
    "mw04:teardown": "node scripts/mw04-teardown.mjs",
    "mw04:teardown:confirm": "node scripts/mw04-teardown.mjs --confirm",
    "mw04:verify-leftovers": "node scripts/mw04-leftover-verify.mjs",
    "mw06:deploy": "node scripts/mw06-deploy.mjs",
    "mw06:verify": "node scripts/mw06-verify.mjs",
    "mw06:verify-leftovers": "node scripts/mw06-leftover-verify.mjs",
    "mw08:deploy": "node scripts/mw08-deploy.mjs",
    "mw08:verify": "node scripts/mw08-verify.mjs",
    "mw08:cleanup": "node scripts/mw08-cleanup.mjs",
    "mw08:import-known-ids": "node scripts/mw08-import-known-ids.mjs",
    "mw08:verify-leftovers": "node scripts/mw08-leftover-verify.mjs",
    "mw09:deploy": "node scripts/mw09-deploy.mjs",
    "mw09:verify": "node scripts/mw09-verify.mjs",
    "mw09:cleanup": "node scripts/mw09-cleanup.mjs",
    "mw09:import-known-ids": "node scripts/mw09-import-known-ids.mjs",
    "mw09:verify-leftovers": "node scripts/mw09-leftover-verify.mjs",
    "mw10:deploy": "node scripts/mw10-deploy.mjs",
    "mw10:verify": "node scripts/mw10-verify.mjs",
    "mw10:cleanup": "node scripts/mw10-cleanup.mjs",
