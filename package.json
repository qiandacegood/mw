{
  "name": "mw",
  "private": true,
  "version": "0.0.1",
  "description": "思维工坊工程。CloudBase SDK 与 CLI 使用锁定版本，不使用 latest。",
  "workspaces": [
    "apps/admin",
    "apps/miniprogram",
    "packages/shared",
    "services/api"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:prototypes": "node scripts/check-prototype-scripts.mjs",
    "test": "node scripts/check-prototype-scripts.mjs && node scripts/ensure-shared-js.mjs && node scripts/mw04-record.test.mjs && npm run test --workspaces --if-present",
    "build": "node scripts/ensure-shared-js.mjs && npm run build --workspaces --if-present",
    "mw04:validate": "node scripts/mw04-validate.mjs",
    "mw04:teardown": "node scripts/mw04-teardown.mjs",
    "mw04:teardown:confirm": "node scripts/mw04-teardown.mjs --confirm"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudbase/cli": "3.8.5",
    "@types/node": "^24.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
