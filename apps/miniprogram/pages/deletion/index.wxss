.page { padding: 24px; }
.h1 { font-size: 20px; font-weight: 600; display: block; }
.muted, .title { display: block; margin-top: 8px; color: #4a5568; }
.card { margin-top: 12px; padding: 14px; background: #fff; border-radius: 10px; }
.draft { margin-top: 8px; max-height: 160px; }
button { margin-top: 16px; background: #2b6cb0; color: #fff; }
button[disabled] { background: #a0aec0; }
.ghost { background: #edf2f7; color: #2d3748; }
