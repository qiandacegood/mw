<view class="page">
  <text class="h1">会员注册</text>
  <text class="muted">须主动勾选当前协议与隐私版本。不预勾选，不强制手机号，不抓取微信头像昵称。本轮为带版本号的测试稿，非正式运营条款。</text>
  <text class="title">{{agreementTitle}} / {{agreementVersion}}</text>
  <scroll-view class="draft" scroll-y>
    <text class="muted">{{agreementText}}</text>
  </scroll-view>
  <text class="title">{{privacyTitle}} / {{privacyVersion}}</text>
  <scroll-view class="draft" scroll-y>
    <text class="muted">{{privacyText}}</text>
  </scroll-view>
  <view class="box">
    <checkbox-group bindchange="onAgree">
      <label>
        <checkbox value="agreement" checked="{{accepted}}" />
        我已阅读并同意当前有效的用户协议和隐私政策
      </label>
    </checkbox-group>
  </view>
  <button bindtap="submit" disabled="{{busy}}">确认注册</button>
  <text class="title">{{result}}</text>
</view>
