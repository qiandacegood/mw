.page { padding: 16px 16px 32px; }
.bar { display: flex; justify-content: space-between; align-items: center; }
.title { font-size: 16px; font-weight: 600; }
.save { font-size: 13px; color: #4a5568; }
.save.saving { color: #b7791f; }
.save.saved { color: #276749; }
.save.failed, .save.offline, .save.conflict { color: #c53030; }
.card { margin-top: 12px; padding: 14px; background: #fff; border-radius: 10px; }
.stem { font-size: 16px; display: block; margin-bottom: 10px; }
.option { margin-top: 8px; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; }
.option.on { border-color: #2b6cb0; background: #ebf8ff; }
.muted { display: block; margin-top: 8px; color: #4a5568; }
.err { color: #c53030; }
.grid { display: flex; flex-wrap: wrap; margin-top: 8px; }
.no { width: 36px; height: 36px; line-height: 36px; text-align: center; margin: 4px; border-radius: 18px; background: #edf2f7; }
.no.done { background: #c6f6d5; }
.no.cur { outline: 2px solid #2b6cb0; }
button { margin-top: 12px; background: #2b6cb0; color: #fff; }
.ghost { background: #edf2f7; color: #2d3748; }
