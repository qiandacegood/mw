<view class="page">
  <view wx:if="{{state === 'loading'}}" class="card">加载中…</view>
  <view wx:elif="{{state === 'error'}}" class="card err">
    <text>{{message}}</text>
    <button bindtap="reload">重试</button>
  </view>
  <view wx:elif="{{status === 'inProgress'}}" class="card">
    <text>评分处理中或尚未交卷。将查询原答题记录，不新建一轮。</text>
    <button bindtap="reload">刷新结果</button>
  </view>
  <block wx:else>
    <text class="h1">本次 {{score}} / {{maxScore}}</text>
    <text class="muted">历史最高 {{bestScore}} · 本次新增 +{{delta}}</text>
    <text class="muted">总分 {{totalScore}} · 等级 {{levelId}}</text>
    <text class="muted">答对 {{correctCount}} / {{questionCount}}</text>
    <text wx:if="{{corrected}}" class="note">{{correctionNote}}</text>
    <button bindtap="goAnalysis">查看解析</button>
    <button class="ghost" bindtap="goFeedback">反馈本版题目</button>
    <button class="ghost" bindtap="goHistory">历史成绩</button>
    <view class="card">
      <text class="muted">只有本轮测试 attempt 才应点下面按钮。浏览或自动进页不会记入 leftover。</text>
      <button class="ghost" bindtap="markLeftover">记入本轮 leftover</button>
      <text wx:if="{{leftoverMarked}}" class="muted">已记入。回首页再复制本轮 leftover knownIds。</text>
    </view>
  </block>
</view>
