.page { padding: 20px; }
.h1 { font-size: 20px; font-weight: 600; display: block; }
.muted, .title { display: block; margin-top: 6px; color: #4a5568; }
.row { display: flex; flex-wrap: wrap; margin-top: 8px; }
.card { margin-top: 12px; padding: 14px; background: #fff; border-radius: 10px; }
.err { color: #c53030; }
.tag { display: inline-block; padding: 2px 8px; border-radius: 6px; background: #edf2f7; font-size: 12px; }
.tag.vip { background: #feebc8; color: #7b341e; }
button { margin: 8px 8px 0 0; background: #2b6cb0; color: #fff; }
