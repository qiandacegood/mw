.page { padding: 20px 20px 32px; }
.h1 { font-size: 22px; font-weight: 600; display: block; }
.h2 { font-size: 17px; font-weight: 600; display: block; margin-top: 20px; }
.muted, .title { display: block; margin-top: 6px; color: #4a5568; }
.card { margin-top: 12px; padding: 14px; background: #fff; border-radius: 10px; }
.err { color: #c53030; }
.tag { display: inline-block; margin-right: 8px; padding: 2px 8px; border-radius: 6px; background: #edf2f7; font-size: 12px; }
.tag.vip { background: #feebc8; color: #7b341e; }
.input { margin-top: 8px; padding: 8px; background: #edf2f7; }
button { margin-top: 12px; background: #2b6cb0; color: #fff; }
