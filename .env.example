# 占位变量名。值全部无效，禁止填入真实凭据。
CLOUDBASE_ENV_ID=env-placeholder-not-real
WECHAT_APP_ID=wx_placeholder_appid
MW_ALLOWED_MINI_APPIDS=wx_placeholder_appid
# 资源方 AppID = 钱大册小程序 AppID（云环境的微信关联方）。不是思维工坊自己的 AppID。
# 只写在本文件的真实副本 .env 里，不要提交。
MW_RESOURCE_APPID=wx_placeholder_resource_appid
MW_ADMIN_UID=uid-placeholder-not-real
APP_ENV=local
VIRTUAL_PAY_OFFER_ID=offer_placeholder
VIRTUAL_PAY_ENV=sandbox-placeholder

