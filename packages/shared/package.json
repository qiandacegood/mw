{
  "name": "@mw/shared",
  "private": true,
  "version": "0.0.1",
  "description": "共享契约与规则。源码在 src；Node/Vitest 使用 tsc 生成的 dist；小程序构建从同一 src 打到 miniprogram_npm。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "build": "node ../../scripts/ensure-shared-js.mjs"
  }
}
